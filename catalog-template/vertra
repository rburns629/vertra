#!/usr/bin/env bash
# Runs vertra, the platform's command line, at the release pinned below:
# downloaded once into .vertra/ and checked against its SHA-256 before it
# ever runs. A catalog uses its `vertra catalog ...` commands:
#
#   ./vertra catalog check      validate, build, test and scan (what a pull request runs)
#   ./vertra catalog --help     the rest
#
# Each release's binaries are blobs in the platform's public package
# (ghcr.io/<owner>/<repo>/cli), addressed by their SHA-256: what's pinned
# below is what's downloaded, nothing else. A platform checkout's
# .github/scripts/pin-vertra.sh <version> writes the pins.
#
# VERTRA_BIN runs a vertra of your own instead (one built from a platform
# checkout: .github/scripts/build-vertra.sh there).
set -euo pipefail

version="0.3.2"
registry="https://ghcr.io"
repository="rburns629/vertra/cli"

root=$(cd "$(dirname "$0")" && pwd)
export VERTRA_CATALOG_ROOT="$root"

if [ -n "${VERTRA_BIN:-}" ]; then
  exec "$VERTRA_BIN" "$@"
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) echo "vertra: no release for $(uname -m)" >&2; exit 1 ;;
esac
platform="$os-$arch"
# Each platform's binary's SHA-256 (the release's vertra-checksums.txt).
case $platform in
  linux-amd64) sha256="5d9c2b9f3ad7909d65bac519a75ee4b0830efd7ecef248b1e7ec3bf030eee2c6" ;;
  linux-arm64) sha256="83949f9e731ebda16bcae5bc07297f616f775f2eb867895acc0a83386d8d7a96" ;;
  darwin-amd64) sha256="1c2f66fa3b5c55724d7b93b0e028113c5e9ff26d3320dedd01f8076a13203589" ;;
  darwin-arm64) sha256="359db2d303c51b8e6ba3e81a2754de2fedd250a5ac2cc35d37ef9f0e6eac6a78" ;;
  *) echo "vertra: no release for $platform" >&2; exit 1 ;;
esac
if [ -z "$version" ] || [ -z "$sha256" ]; then
  echo "vertra: no release is pinned in ./vertra yet; set VERTRA_BIN to a vertra" >&2
  echo "built from the platform repository (.github/scripts/build-vertra.sh)." >&2
  exit 1
fi

binary="$root/.vertra/$version/vertra-$platform"
if [ ! -x "$binary" ]; then
  mkdir -p "$(dirname "$binary")"
  download=$(mktemp "$binary.XXXXXX")
  trap 'rm -f "$download"' EXIT
  # An anonymous pull token (the package is public); a registry that
  # needs none answers without one.
  token=$(curl -fsSL "$registry/token?scope=repository:$repository:pull" 2>/dev/null |
    sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p' || true)
  auth=()
  if [ -n "$token" ]; then auth=(-H "Authorization: Bearer $token"); fi
  # (Written so an empty list survives bash 3.2's set -u, macOS's bash.)
  curl -fsSL --retry 3 ${auth[@]+"${auth[@]}"} -o "$download" "$registry/v2/$repository/blobs/sha256:$sha256"
  if command -v sha256sum > /dev/null; then
    actual=$(sha256sum "$download" | cut -d' ' -f1)
  else
    actual=$(shasum -a 256 "$download" | cut -d' ' -f1)
  fi
  if [ "$actual" != "$sha256" ]; then
    echo "vertra: the download's SHA-256 is $actual, not the pinned $sha256: refusing to run it" >&2
    exit 1
  fi
  chmod +x "$download"
  mv "$download" "$binary"
fi
exec "$binary" "$@"
