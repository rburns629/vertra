{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acyclix team (team.yaml)",
  "description": "One team: a team, its folder catalog/<name>/ and its namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "description", "owner"],
  "properties": {
    "name": {
      "description": "The team's folder name, which is also its team and namespace.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "owner": { "type": "string", "minLength": 1 },
    "contact": { "type": "string" }
  }
}
