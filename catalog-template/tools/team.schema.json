{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertra team (team.yaml), format v2",
  "description": "One team: a team, its folder catalog/<name>/ and its namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "displayName",
    "description",
    "owner"
  ],
  "properties": {
    "apiVersion": {
      "description": "The catalog format: vertra.dev/v2. A file without it is from before v2: ./vertra catalog migrate rewrites it.",
      "const": "vertra.dev/v2"
    },
    "kind": {
      "description": "What the file is: Team.",
      "const": "Team"
    },
    "name": {
      "description": "The team's folder name, which is also its team and namespace.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string"
    },
    "help": {
      "description": "Where people running your products ask for help, shown when one of your steps fails.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "chat": {
          "description": "A chat channel, e.g. #gcp-platform-help.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "description": "Your runbooks or support page.",
          "type": "string",
          "pattern": "^https://",
          "maxLength": 500
        }
      }
    },
    "allowedTargets": {
      "description": "Where other teams may aim this team's products: for each rule, the teams it covers (or \"*\" for every team) and the values each kind of target may take. An action input typed (x-vertra-needs) gcp.project, gcp.folder, aws.account or azure.subscription is a target; when another team runs the action, each target it supplies must match a rule for that team, or the run is refused. Left out, other teams may not supply targets at all. Your own team's runs aren't limited.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "teams"
        ],
        "properties": {
          "teams": {
            "description": "The teams this rule covers, or [\"*\"] for every team.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "const": "*"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                }
              ]
            }
          },
          "gcp.project": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_./:*-]+$",
              "description": "A value, or a pattern where * matches any run of characters (azure-apps-*)."
            }
          },
          "gcp.folder": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_./:*-]+$",
              "description": "A value, or a pattern where * matches any run of characters (azure-apps-*)."
            }
          },
          "aws.account": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_./:*-]+$",
              "description": "A value, or a pattern where * matches any run of characters (azure-apps-*)."
            }
          },
          "azure.subscription": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_./:*-]+$",
              "description": "A value, or a pattern where * matches any run of characters (azure-apps-*)."
            }
          },
          "approval": {
            "description": "Runs this rule lets through still wait for a maintainer of this team to approve each step that aims at one of its targets.",
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "gcp.project"
            ]
          },
          {
            "required": [
              "gcp.folder"
            ]
          },
          {
            "required": [
              "aws.account"
            ]
          },
          {
            "required": [
              "azure.subscription"
            ]
          }
        ]
      }
    }
  }
}
