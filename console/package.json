{
  "name": "execution-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secret registration and RBAC provisioning backend for the marketplace platform. Deploys alongside kernel-api/kernel-scheduler; see the top-level README for how the pieces fit together.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "chat-eval": "tsx scripts/chat-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-ecr": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/credential-provider-node": "3.972.88",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-fastify": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/static": "^10.1.7",
    "@kubernetes/client-node": "^2.0.1",
    "@sinclair/typebox": "^0.34.52",
    "@smithy/signature-v4": "5.7.4",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jose": "6.2.13",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
