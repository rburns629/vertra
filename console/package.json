{
  "name": "execution-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secret registration and RBAC provisioning backend for the marketplace platform. Deploys alongside kernel-api/kernel-scheduler; see the top-level README for how the pieces fit together.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.2.0",
    "@kubernetes/client-node": "^2.0.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
