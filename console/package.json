{
  "name": "execution-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secret registration and RBAC provisioning backend for the marketplace platform. Deploys alongside kernel-api/kernel-scheduler; see the top-level README for how the pieces fit together.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecr": "3.1146.0",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-fastify": "2.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@kubernetes/client-node": "^1.0.0",
    "@sinclair/typebox": "^0.33.17",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.1.11"
  }
}
