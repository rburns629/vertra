# Personal, never shared: scratch files, and anything cloned alongside for
# convenience, such as a catalog repository (it has its own git history).
_local/

# vertra's per-install settings and OpenTofu state (cli/DESIGN.md):
# names only, but the state can hold resource details. Keep them in a
# private repository of your own if you want them versioned.
deploy/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Node (console/)
node_modules/
*.tsbuildinfo
npm-debug.log*

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / local config
.env
.env.*

# Editor / OS
.DS_Store
.vscode/
.idea/
.claude/
.impeccable/
_local/
# OpenTofu working files, should a module be initialised in place.
cli/internal/modules/*/.terraform/
# Built binaries (.github/scripts/build-vertra.sh; the kernel's kind tests in CI).
cli/bin/
kernel/bin/

# The vertra binary, built in place (`go build -o vertra ./cmd/vertra`).
/cli/vertra
