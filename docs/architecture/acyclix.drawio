eometry></mxCell><mxCell id="1-99" value="One execution, in order: ① A person or pipeline calls the console, which checks team membership, identity, team secrets and images. ② The console forwards the DAG to kernel-api, which validates it and stores it (PENDING). ③ kernel-scheduler claims READY tasks&#10;from Postgres. ④ For each, it creates a ConfigMap holding request.json, and a Job, through the API server, whose admission policies can refuse them (DISPATCH_REJECTED, IMAGE_NOT_ALLOWED, IMAGE_NOT_SIGNED, IDENTITY_NOT_ALLOWED). ⑤ The Pod runs as its product's&#10;ServiceAccount with the team Secrets its step lists and writes result.json; the scheduler reads it, stores outputs and logs, deletes the Job, and releases the tasks that waited on it. kernel-api and kernel-scheduler never call each other: Postgres rows are&#10;their only channel." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fffbe6;strokeColor=#d6b656;html=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="1920" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2 · Kernel classes"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-2" value="Kernel (kernel/app): every module, class and function" style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="2-3" value="Generated from the source by docs/architecture/generate.py.  + public, - private." style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1800" height="24" as="geometry"/></mxCell><mxCell id="2-4" value="Dashed arrows above: «import». The package at the tail imports the package at the head." style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="700" height="20" as="geometry"/></mxCell><mxCell id="2-5" value="contracts/  (API and container shapes, pydantic)" style="rounded=1;arcSize=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;dashed=1;html=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="558" width="815" height="1520" as="geometry"/></mxCell><mxCell id="2-6" value="«pydantic»&#10;ExecutionSubmission  (execution.py)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;html=0;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="344" height="93" as="geometry"/></mxCell><mxCell id="2-7" value="external_reference: str&#10;idempotency_key: str&#10;tasks: list[TaskDefinition]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Menlo;fontSize=11;" vertex="1" parent="2-6"><mxGeometry x="0" y="40" width="344" height="53" as="geometry"/></mxCell><mxCell id="2-8" value="«pydantic»&#10;ExecutionSubmissionResponse  (execution.py)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;html=0;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent